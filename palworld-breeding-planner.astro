---
import MainLayout from "../../layouts/MainLayout.astro"; import "../../styles/global.css";
---
<MainLayout title="Palworld Breeding Planner" description="A free manual Palworld breeding planner to organize parent Pals and breeding goals.">
<section class="page-hero container"><span class="pill">PALWORLD TOOL</span><h1>Palworld Breeding <span class="gradient-text">Planner.</span></h1><p class="lead" style="margin:0">Organize a breeding goal and keep track of parent Pals and traits.</p></section>
<section class="tool-shell">
<h2>Plan a breeding pair</h2>
<div class="notice">This is a manual planning worksheet, not an official offspring predictor. Exact breeding outcomes require a verified game-version dataset, which is not included yet.</div>
<div class="form-row">
<div class="field"><label for="parent-a">Parent Pal A</label><input id="parent-a" placeholder="Enter parent Pal name"/></div>
<div class="field"><label for="parent-b">Parent Pal B</label><input id="parent-b" placeholder="Enter parent Pal name"/></div>
</div>
<div class="form-row">
<div class="field"><label for="target-pal">Desired offspring / goal</label><input id="target-pal" placeholder="What are you aiming for?"/></div>
<div class="field"><label for="traits">Desired traits</label><input id="traits" placeholder="Traits or passive skills"/></div>
</div>
<div class="field"><label for="notes">Notes</label><textarea id="notes" rows="3" placeholder="Add game version, breeding route or reminders"></textarea></div>
<button class="button" id="save-plan">Create plan</button>
<div id="plan-result" class="result hidden" aria-live="polite"></div>
</section>
<script>
  const $ = id => document.getElementById(id);
  $("save-plan")?.addEventListener("click", () => {
    const a=$("parent-a").value.trim(), b=$("parent-b").value.trim(), target=$("target-pal").value.trim();
    if(!a || !b || !target){ $("plan-result").textContent="Please enter both parent Pals and your target goal."; $("plan-result").classList.remove("hidden"); return; }
    $("plan-result").innerHTML = `<strong>Breeding plan created</strong><br>Parent A: ${escapeText(a)}<br>Parent B: ${escapeText(b)}<br>Goal: ${escapeText(target)}<br>Traits: ${escapeText($("traits").value || "Not specified")}<br>Notes: ${escapeText($("notes").value || "None")}`;
    $("plan-result").classList.remove("hidden");
  });
  function escapeText(s){return s.replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));}
</script>
</MainLayout>
